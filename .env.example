# Copy this file to .env and fill in your own values. Never commit .env.
# Pick one provider: gemini, openai (also OpenRouter, Groq, Ollama and others) or anthropic.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
JUDGE_API_KEY=
# Only for openai-compatible servers other than OpenAI itself, for example http://localhost:11434/v1 for Ollama.
JUDGE_BASE_URL=
# Seconds to wait for one model call (default 30).
JUDGE_TIMEOUT=